# Source-only kernel built on the macOS Actions runner (used only for its
# xcodebuild/xcrun/iig toolchain). Target device is the Galaxy Tab S9 Ultra
# (SM-X910); all q2q/Qualcomm hardware stays OFF. This enables the sheng-style
# code-signing infrastructure: trust cache runtime, the native 4K CodeDirectory
# hash cache, and the device-tree panic region (so no BCM2837 panic-buffer
# access and no binary panic-region patch are needed). Apple APFS is prelinked
# locally and the restore volume is mounted from RAM (md0).
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_DT_PANIC_REGION=y
# X910 native UFS root (sheng's NativeUfs selecting the dedicated ipadosroot partition), with the
# real VerifiedRoot code and an empty owner policy carrier filled locally.
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/x910-verified-root/libX910VerifiedRoot.a"
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y
CONFIG_XNU_SHENG_PMGR=y
CONFIG_XNU_BOOT_PROGRESS=n

# Native ARMv8.1+ PAN: required for copyin/copyout after EL0 exceptions.
CONFIG_XNU_NATIVE_PAN=y

# Original Image4 ignition needs the native software-key AES service.
CONFIG_XNU_NATIVE_AES=y

# X910 owner root (stage A): mount the main OS volume as root, authorized by the owner-signed NativeUfs
# windows (sheng's offline-owner-root-binding-audit + OWNER_ROOT_TRUST), queries carried by X910RootAuthority.cpp.
CONFIG_XNU_X910_UFS_ROOT=y
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
# X910 owner root (stage B): authenticated SystemOS cryptex union-mounted on /, owner boot-manifest publication
# from both signed manifests, and dyld startup with the mounted shared cache (sheng's offline-owner-systemos-mount).
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
# X910 owner root (stage C4): the Data volume (APFS B3A302CD..., grown 16 GiB sparse seed built on the runner from
# the original OS private/var, Setup marked done) served by NativeRamBlock from the packed ramdisk, its changed pages
# persisted to the NativeUfs store at the end of ipadosroot (sheng-data-persist), mounted at /private/var.
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="B3A302CD-24A9-4E93-9F5F-51E9056E2490"
