+static volatile unsigned x910_pac_started,x910_pac_state,x910_pac_delivered,x910_pac_seen;
+struct x910_pac_rule {const unsigned char *begin,*end,*recover;};
+static const struct x910_pac_rule x910_pac_rules[]={
+ {x910_pac_key_ia_begin,x910_pac_key_ia_end,x910_pac_key_ia_recover},
+ {x910_pac_key_ib_begin,x910_pac_key_ib_end,x910_pac_key_ib_recover},
+ {x910_pac_key_da_begin,x910_pac_key_da_end,x910_pac_key_da_recover},
+ {x910_pac_key_db_begin,x910_pac_key_db_end,x910_pac_key_db_recover},
+ {x910_pac_key_ga_begin,x910_pac_key_ga_end,x910_pac_key_ga_recover},
+ {x910_pac_ia_enable,x910_pac_ia_enable+4,x910_pac_ia_fail_no_restore},
+ {x910_pac_ia_sign,x910_pac_ia_sign+4,x910_pac_ia_fail_restore},
+ {x910_pac_ia_auth,x910_pac_ia_auth+4,x910_pac_ia_fail_restore},
+ {x910_pac_ga_sign,x910_pac_ga_sign+4,x910_pac_ga_recover},
+};
+bool x910_pac_probe_recover(arm_saved_state_t *,uint32_t,uint64_t);
+void x910_pac_probe_start(void);
+int x910_pac_probe_format(char *,unsigned long);
+extern int x910_pac_report_file_write(const char *,unsigned long);
+
+// This hook must run before SLEH's exception-class switch. It consumes only
+// PAuth/sysreg traps at our own exact assembly PCs while this CPU's probe is active.
+bool x910_pac_probe_recover(arm_saved_state_t *state,uint32_t esr,uint64_t far) {
+ unsigned cpu=(unsigned)cpu_number(),ec=ESR_EC(esr);
+ if(cpu>=8 || PSR64_IS_USER(get_saved_state_cpsr(state)) ||
+    (ec!=0 && ec!=0x18 && ec!=0x1c))return false;
+ volatile struct x910_pac_record *r=&x910_pac_records[cpu];
+ if(!__atomic_load_n(&r->active,__ATOMIC_ACQUIRE))return false;
+ uintptr_t pc=(uintptr_t)get_saved_state_pc(state);
+ for(unsigned i=0;i<sizeof(x910_pac_rules)/sizeof(x910_pac_rules[0]);++i) {
+  const struct x910_pac_rule *rule=&x910_pac_rules[i];
+  if(pc<(uintptr_t)rule->begin || pc>=(uintptr_t)rule->end || ((pc-(uintptr_t)rule->begin)&3))continue;
+  r->esr=esr;r->far=far;r->traps++;r->last_operation=i*4+(unsigned)((pc-(uintptr_t)rule->begin)/4);
+  saved_state64(state)->pc=(uintptr_t)rule->recover;
+  return true;
+ }
+ return false;
+}
+
+static void x910_pac_on_cpu(void *unused) {
+ (void)unused;unsigned cpu=(unsigned)cpu_number();if(cpu>=8)return;
+ volatile struct x910_pac_record *r=&x910_pac_records[cpu];
+ boolean_t intr=ml_set_interrupts_enabled(FALSE);
+ // IPIs already run non-preemptibly; balance an additional explicit hold.
+ disable_preemption();
+ __asm__ volatile("mrs %0, CurrentEL":"=r"(r->current_el));
+ __asm__ volatile("mrs %0, MPIDR_EL1":"=r"(r->mpidr));
+ __asm__ volatile("mrs %0, ID_AA64ISAR1_EL1":"=r"(r->isar1));
+ __asm__ volatile("mrs %0, S3_0_C0_C6_2":"=r"(r->isar2));
+ __asm__ volatile("mrs %0, SCTLR_EL1":"=r"(r->sctlr));
+ r->seen=1;__atomic_fetch_or(&x910_pac_seen,1U<<cpu,__ATOMIC_RELAXED);
+ if(r->current_el==4) {
+  __atomic_store_n(&r->active,1,__ATOMIC_RELEASE);
+  unsigned (*const tests[])(void)={x910_pac_key_ia,x910_pac_key_ib,x910_pac_key_da,x910_pac_key_db,x910_pac_key_ga};
+  for(unsigned k=0;k<5;++k){r->stage=10+k;if(tests[k]()==0)r->key_pairs|=1U<<k;}
+  // Synthetic pointers only. No signed pointer is dereferenced or published.
+  for(unsigned i=0;i<8;++i) {
+   r->stage=20+i;
+   unsigned out=x910_pac_ia_test(0x100001000ULL+4096ULL*i,0x5839313000000000ULL+i+cpu*16U);
+   if(out&1)r->ia_restored|=1U<<i;
+   if(out&2)r->ia_changed|=1U<<i;
+   r->stage=30+i;
+   if(x910_pac_ga_test(0x100001000ULL+4096ULL*i,0x5839313000000000ULL+i+cpu*16U))r->ga_nonzero|=1U<<i;
+  }
+  __atomic_store_n(&r->active,0,__ATOMIC_RELEASE);
+ }
+ r->stage=40;
+ enable_preemption();(void)ml_set_interrupts_enabled(intr);
+}
+
+int x910_pac_probe_format(char *out,unsigned long capacity) {
+ if(!out || capacity<256)return -1;
+ uint64_t ns=0;absolutetime_to_nanoseconds(mach_absolute_time(),&ns);
+ unsigned long used=(unsigned long)snprintf(out,capacity,
+  "X910REPORT-BEGIN round=1500 uptime=%llu s pac build=x910-pac-el1-v1\n"
+  "state=%u delivered=%u seen=%02x el0=UNTESTED new_key_values=UNTESTED\n",
+  (unsigned long long)(ns/NSEC_PER_SEC),x910_pac_state,x910_pac_delivered,x910_pac_seen);
+ for(unsigned i=0;i<8 && used<capacity-64;++i) {
+  const volatile struct x910_pac_record *r=&x910_pac_records[i];
+  used+=(unsigned long)snprintf(out+used,capacity-used,
+   "PAC cpu=%u seen=%u stage=%u el=%llx mpidr=%llx isar1=%llx isar2=%llx sctlr=%llx keys=%02x ia_restore=%02x ia_change=%02x ga=%02x traps=%u op=%u esr=%x far=%llx\n",
+   i,r->seen,r->stage,(unsigned long long)r->current_el,(unsigned long long)r->mpidr,
+   (unsigned long long)r->isar1,(unsigned long long)r->isar2,(unsigned long long)r->sctlr,
+   r->key_pairs,r->ia_restored,r->ia_changed,r->ga_nonzero,r->traps,r->last_operation,r->esr,(unsigned long long)r->far);
+ }
+ if(used>=capacity-32)return -1;
+ used+=(unsigned long)snprintf(out+used,capacity-used,"X910REPORT-END\n");
+ return (int)used;
+}
+static void x910_pac_thread(void *argument,wait_result_t result) {
+ (void)argument;(void)result;
+ // Data and the recovery watchdog must already be active before start is called.
+ assert_wait_timeout((event_t)&x910_pac_started,THREAD_UNINT,30,NSEC_PER_SEC);
+ thread_block(THREAD_CONTINUE_NULL);
+ x910_pac_state=3;
+ if(ml_get_max_cpu_number()<8)
+  x910_pac_delivered=cpu_broadcast_xcall_simple(TRUE,x910_pac_on_cpu,(void *)&x910_pac_started);
+ else x910_pac_state=5;
+ if(x910_pac_state==3)x910_pac_state=4;
+ static char report[3800];int n=x910_pac_probe_format(report,sizeof(report));
+ if(n>0)x910_pac_report_file_write(report,(unsigned long)n);
+}
+void x910_pac_probe_start(void) {
+ if(__atomic_exchange_n(&x910_pac_started,1,__ATOMIC_ACQ_REL))return;
+#if __has_feature(ptrauth_calls)
+ // Never run this arm64 diagnostic inside an active arm64e/PAuth kernel.
+ x910_pac_state=6;
+ return;
+#else
+ thread_t thread=THREAD_NULL;x910_pac_state=1;
+ kern_return_t error=kernel_thread_start(x910_pac_thread,NULL,&thread);
+ if(error==KERN_SUCCESS){x910_pac_state=2;thread_deallocate(thread);}
+ else x910_pac_state=7;
+#endif
+}
