+// Derived from sheng d92e7996b9d407a83b8db486b7f633c651d8683c BootFaultProbe.c (MIT).
+// SPDX-License-Identifier: MIT
+// Observe real EL0 breakpoint state before exception delivery changes it.
+// No allocation, process traversal, user-memory access or blocking in the trap.
+#include <kern/task.h>
+#include <kern/thread.h>
+#include <arm/thread.h>
+#include <kern/misc_protos.h>
+#include <kdp/kdp_dyld.h>
+#include <string.h>
+#include <vm/vm_map.h>
+extern int proc_selfpid(void);
+extern void proc_selfname(char *, int);
+
+struct boot_fault_record {
+ unsigned valid;
+ int pid;
+ char name[32];
+ uint64_t pc,lr,sp,fp,esr,far,slide,x[29];
+};
+static struct boot_fault_record faults[8];
+static unsigned fault_lock,fault_count;
+
+static void capture_exception(void *saved,unsigned esr,uint64_t far) {
+ arm_saved_state_t *state=saved;
+ if(__atomic_exchange_n(&fault_lock,1,__ATOMIC_ACQUIRE))return;
+ struct boot_fault_record *f=&faults[fault_count++%8];
+ f->valid=0;f->pid=proc_selfpid();proc_selfname(f->name,sizeof(f->name));
+ f->pc=(uint64_t)get_saved_state_pc(state);f->lr=(uint64_t)get_saved_state_lr(state);
+ f->sp=(uint64_t)get_saved_state_sp(state);f->fp=(uint64_t)get_saved_state_fp(state);f->esr=esr;f->far=far;
+ f->slide=current_task()->task_shared_region_slide;
+ for(unsigned i=0;i<29;++i)f->x[i]=(uint64_t)get_saved_state_reg(state,i);
+ f->valid=1;
+ __atomic_store_n(&fault_lock,0,__ATOMIC_RELEASE);
+}
+
+void x910_fault_user_breakpoint(void *saved,unsigned esr) {capture_exception(saved,esr,0);}
+void x910_fault_user_abort(void *saved,unsigned esr,uint64_t far) {capture_exception(saved,esr,far);}
+// Called on the ordinary exit path before coredump/sync, never from panic or
+// IRQ context. Only read user memory if the recorded process owns this task.
+// Failure to copy is evidence, never a reason to suppress the original panic.
+void x910_fault_critical_exit(int pid, char *out, unsigned long capacity) {
+ struct boot_fault_record f={0};
+ if(__atomic_exchange_n(&fault_lock,1,__ATOMIC_ACQUIRE))return;
+ for(unsigned n=0;n<8 && n<fault_count;++n) {
+  struct boot_fault_record *candidate=&faults[(fault_count-1-n)%8];
+  if(candidate->valid && candidate->pid==pid){f=*candidate;break;}
+ }
+ __atomic_store_n(&fault_lock,0,__ATOMIC_RELEASE);
+ unsigned long used=strlen(out);
+ if(used>=capacity)return;
+ if(!f.valid && pid==proc_selfpid()) {
+  char name[32]={0};proc_selfname(name,sizeof(name));
+  if(!strcmp(name,"MobileSafari") || !strncmp(name,"com.apple.WebKit",16)) {
+   arm_saved_state_t *state=get_user_regs(current_thread());
+   if(state) {
+    f.valid=1;f.pid=pid;strlcpy(f.name,name,sizeof(f.name));
+    f.pc=get_saved_state_pc(state);f.lr=get_saved_state_lr(state);
+    f.sp=get_saved_state_sp(state);f.fp=get_saved_state_fp(state);
+    f.slide=current_task()->task_shared_region_slide;
+    for(unsigned i=0;i<29;++i)f.x[i]=get_saved_state_reg(state,i);
+    snprintf(out+used,capacity-used,"\nEXIT current-thread syscall state (no breakpoint)");
+    used=strlen(out);if(used>=capacity)return;
+   }
+  }
+ }
+ if(!f.valid){snprintf(out+used,capacity-used,"\nEL0 breakpoint record unavailable");return;}
+ uint32_t instruction=0;
+ uint64_t frames[6]={0},frame=f.fp,object[10]={0};
+ char message[161]={0};unsigned long copied=0;
+ int instruction_error=-1,message_error=-1,image_error=-1,object_error=-1;unsigned depth=0;
+ struct user64_dyld_all_image_infos info={0};
+ struct user64_dyld_image_info image={0};char image_path[81]={0};
+ if(pid==proc_selfpid()) {
+  instruction_error=copyin(f.pc,&instruction,sizeof(instruction));
+  image_error=copyin(task_get_all_image_info_addr(current_task()),&info,sizeof(info));
+  if(!image_error && info.infoArrayCount && info.infoArray) {
+   image_error=copyin(info.infoArray,&image,sizeof(image));
+   if(!image_error && copyinstr(image.imageFilePath,image_path,sizeof(image_path),&copied))image_path[0]=0;
+  }
+  for(;depth<3 && frame && !(frame&15);++depth) {
+   uint64_t pair[2];
+   if(copyin(frame,pair,sizeof(pair)))break;
+   frames[depth*2]=pair[0];frames[depth*2+1]=pair[1];
+   if(pair[0]<=frame || pair[0]-frame>1048576){++depth;break;}
+   frame=pair[0];
+  }
+  message_error=copyinstr(f.x[0],message,sizeof(message),&copied);
+  if(message_error)message[0]=0;
+  for(unsigned i=0;message[i];++i)if((unsigned char)message[i]<32 || (unsigned char)message[i]>126)message[i]='?';
+  // 80 bytes at saved x19: the object the original FBSDisplayMode validator
+  // keeps in x19 at its BRK. Checked copyin only; an error is reported as is.
+  if(f.x[19] && !(f.x[19]&7))object_error=copyin(f.x[19],object,sizeof(object));
+ }
+ extern volatile int x910_mg_cache_reset_status;
+ snprintf(out+used,capacity-used,
+  "\nEL0 %.31s PC=%llx LR=%llx SP=%llx FP=%llx ESR=%llx cache+=%llx"
+  "\nINSN=%x err=%d x0=%llx x1=%llx x2=%llx x3=%llx"
+  "\nx19=%llx x20=%llx x21=%llx x22=%llx x23=%llx"
+  "\nx24=%llx x25=%llx x26=%llx x27=%llx x28=%llx mg=%d"
+  "\nx19obj err=%d %llx %llx %llx %llx %llx"
+  "\nx19obj+40 %llx %llx %llx %llx %llx"
+  "\nframes=%u %llx/%llx %llx/%llx %llx/%llx"
+  "\nx0str err=%d %.160s\nimage0=%llx err=%d %.80s",
+  f.name,f.pc,f.lr,f.sp,f.fp,f.esr,f.slide,instruction,instruction_error,
+  f.x[0],f.x[1],f.x[2],f.x[3],f.x[19],f.x[20],f.x[21],f.x[22],f.x[23],
+  f.x[24],f.x[25],f.x[26],f.x[27],f.x[28],x910_mg_cache_reset_status,
+  object_error,object[0],object[1],object[2],object[3],object[4],object[5],object[6],object[7],object[8],object[9],
+  depth,frames[0],frames[1],frames[2],frames[3],frames[4],frames[5],message_error,message,image.imageLoadAddress,image_error,image_path);
+}
+
+// C45 on hardware: backboardd dies with SIGBUS at DC ZVA (ESR 0x92000061, alignment fault) when QuartzCore clears a display-sized
+// buffer, as opening an app does: DC ZVA faults on memory mapped as Device. Emulated from the hook XNU leaves for alignment faults:
+// the block is zeroed with an ordinary copyout and the instruction is stepped over. Nothing else is emulated, so any other alignment
+// fault stays fatal as before. The first address and the page's cache attributes are kept for the report.
+volatile uint64_t x910_zva_count,x910_zva_first_va,x910_zva_first_pc;
+volatile uint32_t x910_zva_first_wimg;
+int x910_fault_zva(void *saved) {
+ arm_saved_state_t *state=saved;
+ uint32_t insn=0;
+ const uint64_t pc=(uint64_t)get_saved_state_pc(state);
+ if(copyin(pc,&insn,sizeof(insn)) || (insn&0xffffffe0)!=0xd50b7420)return -1;
+ uint64_t dczid;__asm__ volatile("mrs %0, dczid_el0":"=r"(dczid));
+ const uint64_t block=4ull<<(dczid&15);
+ static const uint8_t zeros[256];
+ const unsigned rt=insn&31;
+ if((dczid&16) || block>sizeof(zeros) || rt==31)return -1;
+ const uint64_t va=(uint64_t)VM_USER_STRIP_TBI(get_saved_state_reg(state,rt))&~(block-1);
+ if(copyout(zeros,va,block))return -1;
+ if(!x910_zva_count) {
+  extern ppnum_t pmap_find_phys(pmap_t,addr64_t);
+  extern unsigned int pmap_cache_attributes(ppnum_t);
+  const ppnum_t page=pmap_find_phys(current_thread()->map->pmap,va);
+  x910_zva_first_va=va;x910_zva_first_pc=pc;
+  x910_zva_first_wimg=page?pmap_cache_attributes(page):0xffffffff;
+ }
+ __atomic_fetch_add(&x910_zva_count,1,__ATOMIC_RELAXED);
+ add_saved_state_pc(state,4);
+ return 0;
+}
+// A second's sample of the main thread of Settings: pc, lr and the frame chain, written to the message buffer when it has not moved
+// for two samples. Read-only; a thread on another CPU shows its last entry into the kernel, which is where a blocked thread is.
+extern void IOSleep(unsigned);
+extern queue_head_t tasks;
+extern lck_mtx_t tasks_threads_lock;
+// proc_best_name: vm_protos.h
+extern kern_return_t copyinmap(vm_map_t,vm_map_offset_t,void *,vm_size_t);
+static task_t x910_sample_find(void) {
+ task_t found=TASK_NULL,task;
+ lck_mtx_lock(&tasks_threads_lock);
+ queue_iterate(&tasks,task,task_t,tasks) {
+  void *bsd=get_bsdtask_info(task);
+  if(bsd && !strcmp(proc_best_name((struct proc *)bsd),"Preferences")){task_reference(task);found=task;break;}
+ }
+ lck_mtx_unlock(&tasks_threads_lock);
+ return found;
+}
+static void x910_sample_thread(void *arg,wait_result_t wait) {
+ (void)arg;(void)wait;
+ uint64_t last_pc=0,last_lr=0;unsigned same=0;
+ for(;;) {
+  IOSleep(1000);
+  task_t task=x910_sample_find();
+  if(task==TASK_NULL){last_pc=last_lr=0;same=0;continue;}
+  thread_t thread=THREAD_NULL;
+  task_lock(task);
+  if(!queue_empty(&task->threads)){thread=(thread_t)queue_first(&task->threads);thread_reference(thread);}
+  task_unlock(task);
+  if(thread!=THREAD_NULL) {
+   arm_saved_state_t *state=get_user_regs(thread);
+   uint64_t pc=state?get_saved_state_pc(state):0,lr=state?get_saved_state_lr(state):0,fp=state?get_saved_state_fp(state):0;
+   same=(pc==last_pc && lr==last_lr)?same+1:0;
+   last_pc=pc;last_lr=lr;
+   if(same==2 || (same && !(same%10))) {
+    uint64_t frames[6]={0};
+    vm_map_t map=get_task_map(task);
+    for(unsigned i=0;i<6 && fp;++i) {
+     uint64_t pair[2]={0,0};
+     if(copyinmap(map,fp,pair,sizeof(pair))!=KERN_SUCCESS)break;
+     frames[i]=pair[1];fp=pair[0];
+    }
+    printf("x910smp s=%u slide=%llx pc=%llx lr=%llx f=%llx %llx %llx %llx %llx %llx\n",same,(unsigned long long)task->task_shared_region_slide,pc,lr,frames[0],frames[1],frames[2],frames[3],frames[4],frames[5]);
+   }
+   thread_deallocate(thread);
+  }
+  task_deallocate(task);
+ }
+}
+void x910_sample_start(void);
+void x910_sample_start(void) {
+ thread_t thread=THREAD_NULL;
+ if(kernel_thread_start(x910_sample_thread,NULL,&thread)==KERN_SUCCESS)thread_deallocate(thread);
+}

